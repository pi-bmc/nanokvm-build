 &spi2 {
+	/*
+	 * SPI2 repurposed from the SDIO1 WiFi pads for SD-card emulation, acting
+	 * as a bus *slave* (target) for an external SPI-mode SD host. The u-boot
+	 * pinmux (cvi_board_init.c) routes the pads to SPI2.
+	 *
+	 * The compatible is overridden so the master-only stock "snps,dw-apb-ssi"
+	 * driver does NOT bind; the custom CONFIG_SPI_DW_SD_SLAVE driver
+	 * (drivers/spi/spi-dw-sd-slave.c) claims it instead.
+	 *
+	 * WARNING: requires the SPI2 DW_apb_ssi instance to be synthesised
+	 * slave-capable (confirm in the SG2002 TRM). If it is master-only, the
+	 * driver will probe but cannot function as a card.
+	 */
+	compatible = "cvitek,dw-ssi-sd-slave";
 	status = "okay";
 
