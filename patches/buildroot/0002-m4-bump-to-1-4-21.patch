From 875d6aedbc639484e9203c5bcda1a55ecb7ad4c9 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 24 Jun 2026 06:10:00 -0500
Subject: [PATCH] package/m4: bump version to 1.4.21

GNU m4 1.4.20 fails to build with newer host toolchains that expose the
glibc/GCC _Generic compatibility issue in bundled gnulib headers. Bump to
1.4.21, which contains the upstream compatibility fix.

Signed-off-by: Codex <codex@openai.com>
---
 package/m4/m4.hash | 2 +-
 package/m4/m4.mk   | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/package/m4/m4.hash b/package/m4/m4.hash
index a5b8456cc2..b6dcca6c7d 100644
--- a/package/m4/m4.hash
+++ b/package/m4/m4.hash
@@ -1,4 +1,4 @@
 # Locally calculated after checking pgp signature
-sha256  e236ea3a1ccf5f6c270b1c4bb60726f371fa49459a8eaaebc90b216b328daf2b  m4-1.4.20.tar.xz
+sha256  f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66  m4-1.4.21.tar.xz
 # License files, locally calculated
 sha256  3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986  COPYING
diff --git a/package/m4/m4.mk b/package/m4/m4.mk
index 396c2bbee2..d498754b35 100644
--- a/package/m4/m4.mk
+++ b/package/m4/m4.mk
@@ -4,7 +4,7 @@
 #
 ################################################################################
 
-M4_VERSION = 1.4.20
+M4_VERSION = 1.4.21
 M4_SOURCE = m4-$(M4_VERSION).tar.xz
 M4_SITE = $(BR2_GNU_MIRROR)/m4
 M4_LICENSE = GPL-3.0+
-- 
