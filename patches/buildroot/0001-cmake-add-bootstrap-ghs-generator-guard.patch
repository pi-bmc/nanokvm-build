From 12f2d9af86c7670cedc6ab86f919d1c07980f909 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 24 Jun 2026 05:42:00 -0500
Subject: [PATCH] package/cmake: add bootstrap GHS generator guard

CMake's bootstrap object list does not compile the Green Hills MULTI
generator implementation files. On Linux hosts, cmake.cxx still includes the
GHS generator header during bootstrap, which can instantiate references to
cmGlobalGhsMultiGenerator and make the bootstrap link fail.

Add a package patch so Buildroot applies the guard while extracting host-cmake,
without carrying a direct edit in the buildroot submodule working tree.

Signed-off-by: Codex <codex@openai.com>
---
 ...include-ghs-generator-while-bootstrapping.patch | 34 ++++++++++++++++++++++
 1 file changed, 34 insertions(+)
 create mode 100644 package/cmake/0002-cmake-do-not-include-ghs-generator-while-bootstrapping.patch

diff --git a/package/cmake/0002-cmake-do-not-include-ghs-generator-while-bootstrapping.patch b/package/cmake/0002-cmake-do-not-include-ghs-generator-while-bootstrapping.patch
new file mode 100644
index 0000000000..f72bc10450
--- /dev/null
+++ b/package/cmake/0002-cmake-do-not-include-ghs-generator-while-bootstrapping.patch
@@ -0,0 +1,34 @@
+From 0c84ad7bd9a708bc9e21f5d046a27d498d7b7a57 Mon Sep 17 00:00:00 2001
+From: Codex <codex@openai.com>
+Date: Wed, 24 Jun 2026 05:42:00 -0500
+Subject: [PATCH] cmake: do not include GHS generator while bootstrapping
+
+CMake's bootstrap object list does not compile the Green Hills MULTI
+generator implementation files. On Linux hosts, cmake.cxx still includes the
+GHS generator header during bootstrap, which can instantiate references to
+cmGlobalGhsMultiGenerator and make the bootstrap link fail.
+
+The default generator registration is already skipped under CMAKE_BOOTSTRAP,
+so keep the include guarded the same way.
+
+Signed-off-by: Codex <codex@openai.com>
+---
+ Source/cmake.cxx | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/Source/cmake.cxx b/Source/cmake.cxx
+index c317e4af38..56af2bcb4b 100644
+--- a/Source/cmake.cxx
++++ b/Source/cmake.cxx
+@@ -129,7 +129,7 @@
+
+ // NOTE: the __linux__ macro is predefined on Android host too, but
+ // main CMakeLists.txt filters out this generator by host name.
+-#if (defined(__linux__) && !defined(__ANDROID__)) || defined(_WIN32)
++#if !defined(CMAKE_BOOTSTRAP) && ((defined(__linux__) && !defined(__ANDROID__)) || defined(_WIN32))
+ #  include "cmGlobalGhsMultiGenerator.h"
+ #endif
+
+--
+2.43.0
+
--
