From 3b8c1a7cf0c4c1a8eab39e5579f6723e0cf70c7e Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 24 Jun 2026 08:00:00 -0500
Subject: [PATCH] package/dtc: allow host build with newer GCC

DTC 1.7.2 builds with -Werror by default. Newer host GCC versions warn about
discarded const qualifiers in the host DTC tools and libfdt overlay code, which
turns the host-dtc build into a hard failure.

Keep the target DTC flags unchanged and relax only this host warning so the
SDK can build on newer hosts.

Signed-off-by: Codex <codex@openai.com>
---
 package/dtc/dtc.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/package/dtc/dtc.mk b/package/dtc/dtc.mk
index 556d22aa23..f92b39c89c 100644
--- a/package/dtc/dtc.mk
+++ b/package/dtc/dtc.mk
@@ -57,7 +57,7 @@ endef
 
 # host build
 define HOST_DTC_BUILD_CMDS
-	$(HOST_CONFIGURE_OPTS) $(MAKE) EXTRA_CFLAGS="$(HOST_CFLAGS) -fPIC" -C $(@D) $(HOST_DTC_MAKE_OPTS)
+	$(HOST_CONFIGURE_OPTS) $(MAKE) EXTRA_CFLAGS="$(HOST_CFLAGS) -fPIC -Wno-error=discarded-qualifiers" -C $(@D) $(HOST_DTC_MAKE_OPTS)
 endef
 
 define HOST_DTC_INSTALL_CMDS
-- 
2.43.0
