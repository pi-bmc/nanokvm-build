diff --git a/drivers/spi/Kconfig b/drivers/spi/Kconfig
index 74ea6b6b5f74..88d56aaff1c9 100644
--- a/drivers/spi/Kconfig
+++ b/drivers/spi/Kconfig
@@ -281,6 +281,18 @@ config SPI_DW_BT1_DIRMAP
 
 endif
 
+config SPI_DW_SD_SLAVE
+	tristate "DesignWare APB SSI slave-mode SD card emulation"
+	depends on OF
+	help
+	  Operate a DesignWare APB SSI instance as a bus SLAVE that emulates an
+	  SD card to an external SPI-mode SD host (e.g. a 3D printer). Backing
+	  storage is a RAM disk staged via a /dev/sdslaveN char device. Does NOT
+	  use the master-only spi-dw driver or the SPI_SLAVE handler framework;
+	  it drives the FIFO directly for gap-free full-duplex streaming.
+
+	  Requires an SSI instance synthesised slave-capable (check the SoC TRM).
+
 config SPI_DLN2
        tristate "Diolan DLN-2 USB SPI adapter"
        depends on MFD_DLN2
diff --git a/drivers/spi/Makefile b/drivers/spi/Makefile
index 6fea5821662e..46292072a999 100644
--- a/drivers/spi/Makefile
+++ b/drivers/spi/Makefile
@@ -42,6 +42,8 @@ spi-dw-$(CONFIG_SPI_DW_DMA)		+= spi-dw-dma.o
 obj-$(CONFIG_SPI_DW_BT1)		+= spi-dw-bt1.o
 obj-$(CONFIG_SPI_DW_MMIO)		+= spi-dw-mmio.o
 obj-$(CONFIG_SPI_DW_PCI)		+= spi-dw-pci.o
+obj-$(CONFIG_SPI_DW_SD_SLAVE)		+= dw-ssi-sd-slave.o
+dw-ssi-sd-slave-y			:= spi-dw-sd-slave.o sd_spi_target.o
 obj-$(CONFIG_SPI_EFM32)			+= spi-efm32.o
 obj-$(CONFIG_SPI_EP93XX)		+= spi-ep93xx.o
 obj-$(CONFIG_SPI_FALCON)		+= spi-falcon.o
