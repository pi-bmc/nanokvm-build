#!/bin/sh
# i2c-eeprom - present the NanoKVM as an I2C slave EEPROM to the external host.
#
# Repurposes two of the SDIO1 pads as I2C1:
#   SD1_D3 pad (PINMUX 0x030010D0) -> IIC1_SCL   (funcsel 2)
#   SD1_D0 pad (PINMUX 0x030010DC) -> IIC1_SDA   (funcsel 2)
# then registers the kernel i2c-slave-eeprom backend on that bus. The external
# host (Raspberry Pi, as I2C master) then sees a standard I2C EEPROM at
# $EE_ADDR; the NanoKVM reads/writes the same contents locally via
#   /sys/bus/i2c/devices/<bus>-1<addr>/eeprom
# making it a shared store for board ID / config / control data.
#
# Requires: busybox devmem, and the kernel's I2C_SLAVE_EEPROM +
# I2C_DESIGNWARE_SLAVE (both enabled in the board defconfig).

PINMUX_SD1_D3=0x030010D0        # -> IIC1_SCL (funcsel 2)
PINMUX_SD1_D0=0x030010DC        # -> IIC1_SDA (funcsel 2)

# EEPROM model/address (override in /etc/default/i2c-eeprom if desired).
# Model is a kernel i2c-slave-eeprom variant: slave-24c02 (256B, always present),
# slave-24c32 (4K), slave-24c512 (64K) where the kernel driver supports them.
EE_MODEL="slave-24c02"
EE_ADDR="0x50"

[ -r /etc/default/i2c-eeprom ] && . /etc/default/i2c-eeprom

# new_device takes the 7-bit address OR'd with the I2C "own slave address" flag
# (0x1000 in the sysfs interface), e.g. 0x50 -> 0x1050. The resulting i2c client
# then appears in sysfs as "<bus>-1050".
ee_reg()  { printf '0x1%03x' "$(( EE_ADDR & 0x7f ))"; }
ee_slug() { printf '1%03x'   "$(( EE_ADDR & 0x7f ))"; }

# Locate the Linux bus number for the i2c1 controller at 0x04010000.
find_bus() {
    for d in /sys/bus/i2c/devices/i2c-*; do
        p=$(readlink -f "$d" 2>/dev/null)
        case "$p" in
            *4010000.*) echo "${d##*/i2c-}"; return 0 ;;
        esac
    done
    echo 1   # fallback: i2c1 controller conventionally maps to i2c-1
}

start() {
    # Route the pads to I2C1.
    devmem "$PINMUX_SD1_D3" 32 0x2
    devmem "$PINMUX_SD1_D0" 32 0x2

    bus=$(find_bus)
    reg=$(ee_reg)
    nd="/sys/bus/i2c/devices/i2c-$bus/new_device"
    if [ ! -e "$nd" ]; then
        echo "i2c-eeprom: i2c-$bus not found (I2C1 controller absent?)"
        return 1
    fi
    if echo "$EE_MODEL $reg" > "$nd" 2>/dev/null; then
        echo "i2c-eeprom: $EE_MODEL at $EE_ADDR on i2c-$bus"
    else
        echo "i2c-eeprom: instantiate on i2c-$bus failed (already present?)"
    fi
}

stop() {
    bus=$(find_bus)
    reg=$(ee_reg)
    dd="/sys/bus/i2c/devices/i2c-$bus/delete_device"
    [ -e "$dd" ] && echo "$reg" > "$dd" 2>/dev/null
    echo "i2c-eeprom: removed"
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)
        bus=$(find_bus)
        f="/sys/bus/i2c/devices/$bus-$(ee_slug)/eeprom"
        if [ -e "$f" ]; then
            echo "i2c-eeprom: active at $EE_ADDR on i2c-$bus ($f)"
        else
            echo "i2c-eeprom: inactive"
        fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
