# OpenIPMI lanserv emulator command file for the NanoKVM BMC.
#
# This sets up a single management controller (BMC) at address 0x20 and
# enables the System Event Log. See the ipmi_sim / lanserv documentation
# shipped with OpenIPMI for the full command reference.

# Define the BMC as the main management controller.
mc_setbmc 0x20

# Add the BMC:
#   mc_add <ipmb> <device-id> <has-device-sdrs> <device-revision>
#          <major-fw> <minor-fw> <device-support> <mfg-id> <product-id>
mc_add 0x20 0 no-device-sdrs 0x23 9 8 0x9f 0x1291 0xf02 persist_sdr

# Enable the System Event Log for this MC.
sel_enable 0x20 1000 0x0a

# Bring the management controller online.
mc_enable 0x20
