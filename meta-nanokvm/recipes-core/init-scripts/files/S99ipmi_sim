#!/bin/sh
#
# S99ipmi_sim - start the OpenIPMI lanserv simulator (ipmi_sim) as a BMC.
#
# ipmi_sim is shipped by the openipmi package. It presents an IPMI 2.0
# interface over LAN (RMCP+, UDP/623) backed by the emulator command file.
#

DAEMON="ipmi_sim"
IPMI_SIM_BIN="$(command -v ipmi_sim || echo /usr/bin/ipmi_sim)"
CONFIG="/etc/ipmi/lan.conf"
EMU="/etc/ipmi/ipmisim.emu"
STATEDIR="/var/lib/ipmi_sim"
PIDFILE="/var/run/ipmi_sim.pid"

start() {
    printf "Starting %s: " "$DAEMON"

    if [ ! -x "$IPMI_SIM_BIN" ]; then
        echo "FAIL (ipmi_sim binary not found)"
        return 1
    fi

    mkdir -p "$STATEDIR"

    # ipmi_sim daemonizes with -d and writes its own pidfile with -P.
    start-stop-daemon -S -q -p "$PIDFILE" -x "$IPMI_SIM_BIN" -- \
        -c "$CONFIG" -f "$EMU" -s "$STATEDIR" -n -d -P "$PIDFILE"
    status=$?
    if [ "$status" -eq 0 ]; then
        echo "OK"
    else
        echo "FAIL"
    fi
    return "$status"
}

stop() {
    printf "Stopping %s: " "$DAEMON"
    start-stop-daemon -K -q -p "$PIDFILE"
    status=$?
    if [ "$status" -eq 0 ]; then
        echo "OK"
    else
        echo "FAIL"
    fi
    rm -f "$PIDFILE"
    return "$status"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
