#!/bin/sh
# /etc/network/if-post-down.d/nanokvm-usb0
#
# Companion to if-up.d/nanokvm-usb0: stop the usb0 DHCP server and drop the
# nftables isolation table when the gadget NIC goes away (udev-extraconf's
# autonet.rules runs `ifdown usb0` on the netdev remove event, e.g. when the
# app disables the virtual network function). Must exit 0.

[ "$IFACE" = "usb0" ] || exit 0

PIDFILE=/var/run/udhcpd-usb0.pid
if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
fi

if command -v nft >/dev/null 2>&1; then
    nft delete table inet nanokvm_usb0 2>/dev/null
fi

exit 0
