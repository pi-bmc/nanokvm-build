#!/bin/sh
# nanokvm-eth - Ethernet bring-up for the NanoKVM BMC.
#
# Vendored from pi-bmc/nanokvm-app packaging/etc/init.d/S30eth so the Yocto
# image configures eth0 the same way the app expects:
#   - if /boot/eth.nodhcp exists, apply the static config it lists (with a
#     computed gateway + duplicate-address check);
#   - otherwise run udhcpc (DHCP) in the background;
#   - if DHCP yields no lease, fall back to the fixed reserve address so the
#     KVM is always reachable at 192.168.90.1/22.
#
# Requires: iproute2 (ip), busybox udhcpc + its default.script
# (busybox-udhcpc), and arping (iputils-arping) for the static path.

RESERVE_INET="192.168.90.1/22"

clean_line() {
    echo "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\r//g'
}

calc_gw() {
    addr="$1"
    netid="$2"
    IFS=. read a b c d <<EOF
$addr
EOF
    ipnum=$(( (a<<24) + (b<<16) + (c<<8) + d ))
    mask=$(( 0xFFFFFFFF << (32-netid) & 0xFFFFFFFF ))
    gwnum=$(( (ipnum & mask) | 1 ))
    if [ $gwnum -eq $ipnum ]; then
        broadcast=$(( (ipnum & mask) | (0xFFFFFFFF & ~mask) ))
        gwnum=$(( broadcast - 1 ))
    fi
    echo "$(( (gwnum>>24)&255 )).$(( (gwnum>>16)&255 )).$(( (gwnum>>8)&255 )).$(( gwnum&255 ))"
}

# Registered OUI (first 24 bits) for this hardware. eth0's lower 24 bits are
# filled from the immutable SoC eFUSE, giving a globally-unique, stable address
# under the owned OUI -- 48:da:35:xx:xx:xx. Change MAC_OUI if the assigned OUI
# differs. It must be a unicast, universally-administered prefix: octet 0 with
# bit0 (I/G) = 0 and bit1 (U/L) = 0, e.g. 0x48.
MAC_OUI="48:da:35"

# Give eth0 a stable MAC so the DHCP lease (and IP) does not cycle. Mainline
# U-Boot and stmmac provide no MAC for gmac0, so the kernel otherwise synthesises
# a fresh random locally-administered address on every boot. Resolution order:
#   1. /boot/eth.mac        -- an exact address assigned/printed for this unit
#                              (one "xx:xx:xx:xx:xx:xx" line), used verbatim.
#   2. MAC_OUI + eFUSE hash -- OUI kept, lower 3 bytes from a hash of the eFUSE
#                              shadow (immutable per chip => unique + stable
#                              across reboots and reflashes). The sophgo-cv1800
#                              nvmem driver exposes the eFUSE and handles its
#                              clock gating (a raw read would stall the bus).
# If neither source is available the function is a no-op and the kernel's random
# MAC behaviour is unchanged.
set_stable_mac() {
    _mac=
    # 1. Exact per-unit override (e.g. the address on the board's label).
    if [ -s /boot/eth.mac ]; then
        _mac=$(clean_line "$(cat /boot/eth.mac)")
    else
        # 2. Derive the lower 24 bits from the eFUSE, under the fixed OUI.
        _nv=
        for _f in /sys/bus/nvmem/devices/*efuse*/nvmem; do
            [ -r "$_f" ] && { _nv="$_f"; break; }
        done
        [ -n "$_nv" ] || return 1
        _h=$(sha256sum "$_nv" 2>/dev/null | cut -c1-6)
        [ "${#_h}" -eq 6 ] || return 1
        _mac="${MAC_OUI}:$(echo "$_h" | sed 's/\(..\)/\1:/g; s/:$//')"
    fi
    # Require a well-formed xx:xx:xx:xx:xx:xx before touching the interface.
    case "$_mac" in
        [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) ;;
        *) return 1 ;;
    esac
    ip link set dev eth0 down 2>/dev/null
    if ip link set dev eth0 address "$_mac" 2>/dev/null; then
        echo "nanokvm-eth: eth0 MAC set to $_mac"
    fi
    ip link set dev eth0 up 2>/dev/null
}

start() {
    set_stable_mac
    ip addr flush dev eth0 2>/dev/null
    if [ -e /boot/eth.nodhcp ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line=$(clean_line "$line")
            [ -z "$line" ] && continue
            set -- $line
            inet="$1"
            gw="$2"
            [ -z "$inet" ] && continue
            case "$inet" in
                */*) netid_check=${inet#*/}
                    if ! echo "$netid_check" | grep -qE '^[0-9]+$' || [ $netid_check -lt 1 ] 2>/dev/null || [ $netid_check -gt 32 ] 2>/dev/null; then
                        inet="${inet%/*}/16"
                    fi ;;
                *) inet="$inet/16" ;;
            esac
            addr=${inet%/*}
            netid=${inet#*/}
            [ -z "$gw" ] && gw=$(calc_gw "$addr" "$netid")
            arping -Dqc2 -Ieth0 "$addr" || continue
            ip a add "$inet" brd + dev eth0
            ip r add default via "$gw" dev eth0
            echo "nameserver $gw" >> /etc/resolv.conf
            break
        done < /boot/eth.nodhcp

        ip a show dev eth0 | grep inet > /dev/null || {
            udhcpc -i eth0 -t 3 -T 1 -A 5 -b -p /run/udhcpc.eth0.pid >/dev/null 2>&1
            ip a show dev eth0 | grep inet > /dev/null
        } || {
            inet=$RESERVE_INET
            ip a add "$inet" brd + dev eth0
        } || exit 1
    else
        # Retry DHCP indefinitely. A managed switch (e.g. UniFi RSTP) can hold a
        # freshly-linked port in listening/learning for tens of seconds before
        # forwarding, and the internal EPHY link can flap, so the DISCOVERs sent
        # during a short retry window get dropped and no lease is obtained. -t 0
        # means unlimited DISCOVER retransmits (udhcpc never gives up); it is
        # backgrounded with & because -t 0 never reaches the -b self-background
        # path. Once a lease is obtained udhcpc keeps running to renew it.
        udhcpc -i eth0 -t 0 -T 3 -p /run/udhcpc.eth0.pid &
    fi
}

stop() {
    [ ! -e "/run/udhcpc.eth0.pid" ] && exit 1
    kill "$(cat /run/udhcpc.eth0.pid)"
    rm /run/udhcpc.eth0.pid
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload) $0 stop; $0 start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
