#!/bin/sh
# /etc/network/if-pre-up.d/nanokvm-mac
#
# ifupdown pre-up hook: apply the per-unit MAC override, if one has been placed
# on the boot partition. Runs inside `ifup eth0`, before ifupdown's dhcp method
# starts udhcpc, so the first DHCP DISCOVER already carries the final address.
#
# This script used to *derive* a MAC from the eFUSE when no override existed.
# That job now belongs to U-Boot: 0005-licheerv-nano-efuse-mac.patch CRCs the
# eFUSE shadow under the registered OUI and writes the result into the kernel
# device tree as /soc/ethernet@4070000's local-mac-address (ft_board_setup),
# which stmmac consumes directly. Keeping the old fallback here was not merely
# redundant, it was wrong: it hashed the same eFUSE with sha256 rather than CRC,
# so it computed a *different* stable MAC and overwrote U-Boot's on every boot.
#
# What U-Boot does not do is honour an operator override -- ft_board_setup
# writes the derived address unconditionally, ignoring both `ethaddr` and any
# file. So that override is all this hook is for. With no /boot/eth.mac it is a
# no-op and the device-tree address from U-Boot stands.
#
# busybox ifupdown runs /etc/network/if-pre-up.d/* and exports $IFACE.

[ "$IFACE" = "eth0" ] || exit 0
[ -s /boot/eth.mac ] || exit 0

mac=$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\r//g' /boot/eth.mac | head -n1)

case "$mac" in
    [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) ;;
    *) exit 0 ;;
esac

# The address can only be changed while the link is down; bring it back up so
# ifupdown's dhcp method (which just runs udhcpc, and does not raise the link)
# finds eth0 ready.
ip link set dev "$IFACE" down 2>/dev/null
if ip link set dev "$IFACE" address "$mac" 2>/dev/null; then
    logger -t nanokvm-mac "$IFACE MAC overridden to $mac from /boot/eth.mac" 2>/dev/null
fi
ip link set dev "$IFACE" up 2>/dev/null
exit 0
