#!/bin/sh
# /etc/network/if-up.d/nanokvm-usb0
#
# ifupdown post-up hook for the USB gadget NIC (ecm/ncm usb0). The stanza in
# /etc/network/interfaces gives the BMC 169.254.10.1/16 and no gateway; this
# hook adds the rest of the Redfish-Host-Interface-style isolation:
#
#   * forwarding off on usb0 (v4+v6), and an nftables guard that keeps usb0
#     out of the forward path even if ip_forward is later enabled globally
#     (e.g. for WireGuard). The BMC must never bridge or route between the
#     host link and the management LAN.
#   * accept_ra off: the managed host must not be able to steer BMC routing
#     by sending router advertisements down the USB link.
#   * ARP-flux containment so usb0's link-local address never leaks onto the
#     management LAN via eth0, plus per-link anti-spoof/redirect hardening.
#   * a single-lease udhcpd for the host side (no router/DNS options, see
#     udhcpd-usb0.conf), so any host DHCP client gets a working peer address
#     without learning a route or resolver through the BMC.
#
# busybox ifupdown runs /etc/network/if-up.d/* for every interface and
# exports $IFACE. Must exit 0: a failing hook aborts ifup.

[ "$IFACE" = "usb0" ] || exit 0

# There is no procps/sysctl init on this image, so /etc/sysctl.d is never
# applied -- write the knobs straight into /proc here, where they also land at
# exactly the right moment (usb0 exists and is up).

echo 0 > /proc/sys/net/ipv4/conf/usb0/forwarding 2>/dev/null
if [ -d /proc/sys/net/ipv6/conf/usb0 ]; then
    echo 0 > /proc/sys/net/ipv6/conf/usb0/forwarding 2>/dev/null
    echo 0 > /proc/sys/net/ipv6/conf/usb0/accept_ra 2>/dev/null
fi

# ARP-flux containment. The BMC is multi-homed (eth0 -> LAN, usb0 -> host), so
# with the default arp_ignore=0 it will answer an ARP request for usb0's
# 169.254.10.1 that arrives on *eth0*, leaking the host-interface address onto
# the management LAN -- and the UniFi gateway then sees two MACs in link-local
# space. The kernel evaluates arp_{ignore,announce} as
# max(conf/all, conf/<arrival-if>), and the arrival interface here is eth0, so
# the fix must live on conf/all, not conf/usb0:
#   arp_ignore=1   -> reply only when the target IP is on the interface the
#                     request arrived on (eth0 stops answering for 169.254.*).
#   arp_announce=2 -> always source ARP with the best address for the target,
#                     so the 169.254 address is never advertised out eth0.
# Both are standard hardening values and safe for a single-homed eth0.
echo 1 > /proc/sys/net/ipv4/conf/all/arp_ignore 2>/dev/null
echo 2 > /proc/sys/net/ipv4/conf/all/arp_announce 2>/dev/null

# Per-link hardening on usb0: reject source-spoofed packets from the host
# (strict rp_filter), and let neither end steer routing via ICMP redirects.
echo 1 > /proc/sys/net/ipv4/conf/usb0/rp_filter 2>/dev/null
echo 0 > /proc/sys/net/ipv4/conf/usb0/accept_redirects 2>/dev/null
echo 0 > /proc/sys/net/ipv4/conf/usb0/send_redirects 2>/dev/null

# Idempotent: declaring the table first makes the delete safe on first run,
# so re-running ifup replaces rather than duplicates the rules.
if command -v nft >/dev/null 2>&1; then
    nft -f /dev/stdin <<'EOF' 2>/dev/null
table inet nanokvm_usb0
delete table inet nanokvm_usb0
table inet nanokvm_usb0 {
    chain forward {
        type filter hook forward priority -10; policy accept;
        iifname "usb0" counter drop
        oifname "usb0" counter drop
    }
}
EOF
fi

PIDFILE=/var/run/udhcpd-usb0.pid
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    exit 0
fi
if command -v udhcpd >/dev/null 2>&1 && [ -f /etc/udhcpd-usb0.conf ]; then
    udhcpd /etc/udhcpd-usb0.conf 2>/dev/null
fi

exit 0
