#!/bin/sh
# NanoKVM initramfs: assemble the real root and hand off to busybox init.
#
# Boot flow (SD layout: see wic/nanokvm-sd.wks.in):
#   1. Wait for the SD card (the kernel does not wait for us; this replaces
#      the old "rootwait" cmdline parameter).
#   2. (nothing -- see below). Creating/growing the data partition used to
#      happen here; it moved to userspace (nanokvm-growdata) so that no
#      partition-table write ever happens on the boot path.
#   3. Pick a rootfs slot from nanokvm.slot=<a|b> on the kernel cmdline, which
#      U-Boot sets from the same bootslot variable that chose the FIT. A slot
#      that fails to mount falls back to the other, so a half-written image
#      update can never brick the BMC.
#   4. Mount the slot's squashfs read-only, lay a tmpfs overlay upper over it
#      (VOLATILE by design: the root is byte-identical to the image on every
#      boot; anything that must survive lives on the data partition), and
#      mount the data partition at /var/lib/nanokvm inside the new root.
#   5. switch_root into it.
#
# Persistence contract. There are exactly two writable zones: the volatile
# tmpfs overlay above (discarded every boot, so the read-only base can never
# drift) and the userdata partition below (the only thing that survives).
# Anything in the rootfs needing persistence is a SYMLINK into here.
#   /var/lib/nanokvm         ext4 userdata partition (p4), mounted here
#     app/, app.prev/        server self-update install dirs (init script
#                            falls back app -> app.prev -> baked-in /kvmapp)
#     config/                /etc/kvm is a symlink to this
#     ssh/                   SSH host key + authorized_keys (the app is the
#                            SSH server; no sshd in the image)
#     firmware/, media/,     BMC state the server reads/writes: host firmware
#     efivars/, ubootenv/,   capsules staged for the mass-storage gadget, ISO
#     cache/, log/           media, EFI/U-Boot env mirrors, update staging,
#                            host serial-console capture. The BMC no longer
#                            stores a host boot image to serve -- host
#                            firmware is updated with FMP capsules -- so this
#                            partition ships EMPTY from the factory.

PATH=/sbin:/usr/sbin:/bin:/usr/bin
DISK=/dev/mmcblk0
DATA_PART=${DISK}p4

msg() { echo "initramfs: $*"; }

rescue() {
    msg "FATAL: $*"
    msg "dropping to a rescue shell; exit to reboot"
    sh
    reboot -f
}

# The cpio ships no mountpoint directories (PACKAGE_INSTALL carries no
# base-files); without this mkdir the proc/sys mounts fail, the move-mounts
# below fail after them, and the real system's fstab configfs/debugfs mounts
# then fail against an empty /sys. /dev alone survived that: the kernel
# (>=6.8) creates and automounts devtmpfs itself.
mkdir -p /proc /sys /dev
grep -q ' /proc proc' /proc/mounts 2>/dev/null || mount -t proc proc /proc
grep -q ' /sys sysfs' /proc/mounts || mount -t sysfs sysfs /sys
grep -q ' /dev devtmpfs' /proc/mounts || mount -t devtmpfs devtmpfs /dev

# Loopback: the main system runs no ifupdown (the NanoKVM server owns all
# interface addressing), so bring lo up here — the netns is shared with the
# final system, so this sticks across switch_root.
ip link set lo up 2>/dev/null || ifconfig lo up 2>/dev/null

# --- 1. wait for the SD card (rootwait equivalent) -------------------------
tries=0
while [ ! -b ${DISK}p2 ]; do
    tries=$((tries + 1))
    [ $tries -gt 30 ] && rescue "SD card ${DISK} did not appear"
    sleep 1
done

# --- 2. (nothing) ----------------------------------------------------------
# Growing/creating the data partition used to happen here. It does not any
# more: rewriting the partition table of the disk we are booting from is the
# single operation most able to make the card unbootable, and doing it on the
# boot path meant every first boot -- and every power cut during one -- put the
# MBR at risk. It now runs from userspace once the system is up
# (nanokvm-growdata), where a failure costs a retry instead of a brick.
#
# The consequence here: if p4 is missing or unmountable we simply fall back to
# tmpfs (step 4 already did), and the next boot has it.

# --- 3. slot selection -----------------------------------------------------
# The slot arrives on the kernel command line as nanokvm.slot=<a|b>, put there
# by U-Boot from its own bootslot variable. It used to be read from a "slot"
# file on the FAT boot partition, which meant (a) mounting a filesystem here
# just to read one byte, and (b) something, somewhere, writing to the boot
# partition to change it. Now the same variable that picked the FIT picks the
# rootfs, so the two halves of a slot cannot disagree, and nothing on the boot
# path is writable.
SLOT=a
for arg in $(cat /proc/cmdline 2>/dev/null); do
    case "$arg" in
        nanokvm.slot=b) SLOT=b ;;
        nanokvm.slot=a) SLOT=a ;;
    esac
done
if [ "$SLOT" = "b" ]; then
    TRY="${DISK}p3 ${DISK}p2"
else
    TRY="${DISK}p2 ${DISK}p3"
fi

# --- 4. root assembly ------------------------------------------------------
mkdir -p /mnt/ro /mnt/rw /mnt/root
LOWER=
for dev in $TRY; do
    if mount -t squashfs -o ro "$dev" /mnt/ro 2>/dev/null; then
        LOWER=$dev
        break
    fi
    msg "no usable rootfs on $dev, trying fallback slot"
done
[ -n "$LOWER" ] || rescue "no bootable rootfs in either slot"
msg "rootfs: $LOWER (slot $SLOT)"

# Volatile upper: capped so runaway writes to the root can never take the
# whole of RAM (real state belongs on the data partition).
mount -t tmpfs -o size=25%,mode=0755 tmpfs /mnt/rw
mkdir -p /mnt/rw/upper /mnt/rw/work
mount -t overlay \
    -o "lowerdir=/mnt/ro,upperdir=/mnt/rw/upper,workdir=/mnt/rw/work" \
    overlay /mnt/root || rescue "overlay mount failed"

# Userdata partition: fsck, mount inside the new root, create the skeleton the
# rootfs symlinks and the server expect. It ships empty, so this is what makes
# a freshly flashed card usable. If it is damaged beyond -y repair, boot
# anyway with a tmpfs there so the BMC stays reachable for recovery.
mkdir -p /mnt/root/var/lib/nanokvm
if [ -b ${DATA_PART} ]; then
    e2fsck -p ${DATA_PART} >/dev/null 2>&1
    rc=$?
    if [ $rc -ge 4 ]; then
        msg "data partition dirty (e2fsck rc=$rc), retrying with -y"
        e2fsck -y ${DATA_PART} >/dev/null 2>&1
    fi
    if mount -t ext4 -o noatime ${DATA_PART} /mnt/root/var/lib/nanokvm; then
        # Grow the filesystem to the (possibly just-grown) partition. Online
        # ext4 resize needs no prior fsck and is journaled; when the size
        # already matches this is a sub-second no-op, which also self-heals a
        # power cut that landed between the sfdisk grow and here.
        resize2fs ${DATA_PART} >/dev/null 2>&1 || msg "resize2fs failed"
    else
        msg "data partition unmountable; using tmpfs (NO persistence)"
        mount -t tmpfs tmpfs /mnt/root/var/lib/nanokvm
    fi
else
    mount -t tmpfs tmpfs /mnt/root/var/lib/nanokvm
fi
mkdir -p \
    /mnt/root/var/lib/nanokvm/app \
    /mnt/root/var/lib/nanokvm/cache \
    /mnt/root/var/lib/nanokvm/config \
    /mnt/root/var/lib/nanokvm/efivars \
    /mnt/root/var/lib/nanokvm/firmware/files \
    /mnt/root/var/lib/nanokvm/firmware/mnt \
    /mnt/root/var/lib/nanokvm/log \
    /mnt/root/var/lib/nanokvm/media \
    /mnt/root/var/lib/nanokvm/ssh \
    /mnt/root/var/lib/nanokvm/ubootenv

# --- 5. hand off -----------------------------------------------------------
# Keep the squashfs and overlay-upper mounts reachable in the final mount
# namespace. Under /mnt, NOT /run: poky's fstab mounts a fresh tmpfs over
# /run at boot, which would shadow anything moved there.
mkdir -p /mnt/root/mnt/initramfs/ro /mnt/root/mnt/initramfs/rw
mount -o move /mnt/ro /mnt/root/mnt/initramfs/ro
mount -o move /mnt/rw /mnt/root/mnt/initramfs/rw
mount -o move /proc /mnt/root/proc
mount -o move /sys /mnt/root/sys
mount -o move /dev /mnt/root/dev

# Must be exec'd: switch_root takes over as PID 1. If the exec itself fails
# the shell exits and the kernel panics with "attempted to kill init" — the
# honest failure mode at this point (nothing else can run).
exec switch_root /mnt/root /sbin/init
