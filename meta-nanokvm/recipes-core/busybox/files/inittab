# NanoKVM inittab for busybox init (PID 1 after the initramfs switch_root).
#
# Deliberately smaller than poky's stock busybox inittab: the initramfs has
# already mounted proc, sysfs and devtmpfs and moved them into this root, and
# the squashfs+tmpfs-overlay root is born writable — so the stock preamble
# (mount /proc, /sys, /dev; remount rw /) has nothing left to do here.

# /dev/pts and everything in fstab: /run, /var/volatile, /boot, configfs,
# debugfs, and the /etc/kvm bind onto the data partition.
::sysinit:/bin/mkdir -p /dev/pts
::sysinit:/bin/mount -a

# The volatile skeleton populate-volatile.sh used to build (initscripts is
# not installed). /var/log and /var/tmp are image symlinks into /var/volatile.
null::sysinit:/bin/mkdir -p /var/volatile/log /var/volatile/tmp /run/lock

null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
null::sysinit:/bin/busybox hostname -F /etc/hostname

# busybox's rcS runner: walks /etc/rcS.d then /etc/rc5.d — S05zram-swap is
# the only script left (the server is inittab-supervised below, and the old
# S06nanokvm-data firmware seeding moved into the server itself).
::sysinit:/etc/init.d/rcS

# The NanoKVM server, supervised: init restarts the launcher whenever the
# server exits (crash, self-update, TLS change). The launcher re-walks the
# app -> app.prev -> /kvmapp cascade on each start and throttles crash
# loops itself — busybox init's respawn does not.
::respawn:/usr/sbin/nanokvm-server-run

# Reboot/poweroff: stop the server first (it syncs its state on SIGTERM;
# respawn entries are not restarted during shutdown), give it a moment,
# then release swap and storage. umount -r falls back to a read-only
# remount when a filesystem is still busy. There is no rcK/rc6.d walk any
# more — the server was its only member.
::shutdown:/usr/bin/killall NanoKVM-Server
::shutdown:/usr/bin/sleep 2
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r

# Stuff to do when restarting the init process
::restart:/sbin/init

# A serial getty per SERIAL_CONSOLES (ttyS0) is appended below by the
# busybox-inittab recipe.
