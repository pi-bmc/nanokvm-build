# NanoKVM SD card partition layout for Sophgo SG2002 / LicheeRV Nano
#
# Partition map (MBR):
#   Part 1: FAT16, 80 MB  - fip.bin (OpenSBI+U-Boot FIT), boot.sd (kernel+DTB),
#                           plus NanoKVM runtime config files (IMAGE_BOOT_FILES).
#   Part 2: ext4, 1600 MB - root filesystem
#
# U-Boot expects fip.bin and boot.sd in the FAT partition. The ROM/FSBL loads
# fip.bin from a fixed layout; U-Boot then reads the kernel from boot.sd.
#
# NOTE: each wic .wks directive must be on a single line - the parser
# shlex-splits each line individually and does not support backslash
# continuations (a trailing '\' raises "No escaped character").

bootloader --ptable msdos
part /boot --source bootimg-partition --ondisk mmcblk --fstype msdos --label BOOT --active --align 1024 --size 81920K
part / --source rootfs --ondisk mmcblk --fstype ext4 --label rootfs --align 1024 --size 1638400K
