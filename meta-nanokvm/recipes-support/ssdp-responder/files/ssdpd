#!/bin/sh
### BEGIN INIT INFO
# Provides:          ssdpd
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: SSDP/UPnP responder
# Description:       Lightweight SSDP/UPnP responder so the NanoKVM is
#                    discoverable on the LAN.
### END INIT INFO

DAEMON=/usr/sbin/ssdpd
NAME=ssdpd
PIDFILE=/var/run/ssdpd.pid

[ -x "$DAEMON" ] || exit 0

case "$1" in
    start)
        echo -n "Starting $NAME: "
        # ssdpd backgrounds itself and writes $PIDFILE.
        start-stop-daemon -S -x "$DAEMON" -- -p "$PIDFILE" \
            && echo "OK" || echo "FAIL"
        ;;
    stop)
        echo -n "Stopping $NAME: "
        start-stop-daemon -K -p "$PIDFILE" \
            && echo "OK" || echo "FAIL"
        ;;
    restart|reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
