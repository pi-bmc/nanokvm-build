/*
 * FIT image source for the NanoKVM SG2002 / LicheeRV Nano SD boot image.
 *
 * A single kernel + single FDT, RISC-V, uncompressed Image, load/entry at
 * 0x80200000 (2 MiB above the OpenSBI fw_dynamic base at 0x80000000). The
 * resulting boot.itb is deployed as boot.sd into the FAT boot partition, where
 * mainline U-Boot loads it (extlinux.conf -> KERNEL /boot.sd). The FDT is the
 * mainline sophgo/sg2002-licheerv-nano-b.dtb.
 */

/dts-v1/;

/ {
	description = "NanoKVM SG2002 LicheeRV Nano boot image";
	#address-cells = <2>;

	images {
		kernel-1 {
			description = "mainline kernel";
			data = /incbin/("./Image");
			type = "kernel";
			arch = "riscv";
			os = "linux";
			compression = "none";
			load = <0x0 0x80200000>;
			entry = <0x0 0x80200000>;
			hash-2 {
				algo = "crc32";
			};
		};

		fdt-sg2002_licheervnano_sd {
			description = "device tree - sg2002-licheerv-nano-b";
			data = /incbin/("./sg2002-licheerv-nano-b.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			hash-1 {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "config-sg2002_licheervnano_sd";

		config-sg2002_licheervnano_sd {
			description = "boot with board sg2002-licheerv-nano-b";
			kernel = "kernel-1";
			fdt = "fdt-sg2002_licheervnano_sd";
		};
	};
};
