From: NanoKVM build <nbatkins@gmail.com>
Date: Thu, 9 Jul 2026 00:00:00 +0000
Subject: [PATCH] nvmem: sophgo: add CV1800/SG2002 eFUSE driver

Read-only nvmem provider for the Sophgo CV1800B / SG2002 eFUSE shadow
region, adapted from the CVITEK vendor driver (drivers/efuse/cv180x_efuse.c)
to the mainline nvmem framework. Exposes the immutable per-chip fuse data so
userspace can derive a stable Ethernet MAC (mainline U-Boot and stmmac supply
none, so stmmac otherwise generates a fresh random locally-administered MAC on
every boot and the DHCP lease cycles).

Reads enable CLK_EFUSE/CLK_APB_EFUSE first: an access to the eFUSE block while
ungated stalls the APB/AXI bus.

Upstream-Status: Pending
Signed-off-by: NanoKVM build <nbatkins@gmail.com>
---
diff --git a/drivers/nvmem/Kconfig b/drivers/nvmem/Kconfig
index 11b0987..d6044ca 100644
--- a/drivers/nvmem/Kconfig
+++ b/drivers/nvmem/Kconfig
@@ -407,6 +407,18 @@ config NVMEM_SUNPLUS_OCOTP
 	  This driver can also be built as a module. If so, the module
 	  will be called nvmem-sunplus-ocotp.
 
+config NVMEM_SOPHGO_CV1800
+	tristate "Sophgo CV1800/SG2002 eFUSE support"
+	depends on ARCH_SOPHGO || COMPILE_TEST
+	depends on HAS_IOMEM
+	help
+	  This is a read-only driver exposing the eFUSE shadow region of the
+	  Sophgo CV1800B / SG2002 SoCs as an nvmem device -- for example to
+	  derive a stable MAC address from immutable per-chip fuse data.
+
+	  This driver can also be built as a module. If so, the module will be
+	  called nvmem-sophgo-cv1800.
+
 config NVMEM_SUNXI_SID
 	tristate "Allwinner SoCs SID support"
 	depends on ARCH_SUNXI
diff --git a/drivers/nvmem/Makefile b/drivers/nvmem/Makefile
index 70a4464..aa6b10c 100644
--- a/drivers/nvmem/Makefile
+++ b/drivers/nvmem/Makefile
@@ -77,6 +77,8 @@ nvmem_sprd_efuse-y			:= sprd-efuse.o
 obj-$(CONFIG_NVMEM_STM32_ROMEM)		+= nvmem_stm32_romem.o
 nvmem_stm32_romem-y 			:= stm32-romem.o
 nvmem_stm32_romem-$(CONFIG_NVMEM_STM32_BSEC_OPTEE_TA) += stm32-bsec-optee-ta.o
+obj-$(CONFIG_NVMEM_SOPHGO_CV1800)	+= nvmem-sophgo-cv1800.o
+nvmem-sophgo-cv1800-y			:= sophgo-cv1800-efuse.o
 obj-$(CONFIG_NVMEM_SUNPLUS_OCOTP)	+= nvmem_sunplus_ocotp.o
 nvmem_sunplus_ocotp-y			:= sunplus-ocotp.o
 obj-$(CONFIG_NVMEM_SUNXI_SID)		+= nvmem_sunxi_sid.o
diff --git a/drivers/nvmem/sophgo-cv1800-efuse.c b/drivers/nvmem/sophgo-cv1800-efuse.c
new file mode 100644
index 0000000..4afc307
--- /dev/null
+++ b/drivers/nvmem/sophgo-cv1800-efuse.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Sophgo CV1800B / SG2002 eFUSE nvmem provider.
+ *
+ * Adapted for mainline from the CVITEK vendor driver
+ * (drivers/efuse/cv180x_efuse.c in the scpcom licheervnano 5.10 tree). This is
+ * a read-only provider: it exposes the eFUSE "shadow" region -- the copy of the
+ * fused values the hardware auto-loads after reset -- as an nvmem device, so
+ * consumers can read immutable per-chip data. It is used to derive a stable
+ * Ethernet MAC from the chip's unique fuses instead of the random,
+ * locally-administered address stmmac synthesises on every boot when no MAC is
+ * provided.
+ *
+ * The eFUSE macro and its APB interface are clock-gated (CLK_EFUSE and
+ * CLK_APB_EFUSE). Any access to the 0x0305_0000 block while those gates are off
+ * stalls the APB/AXI bus, so every read enables the clocks first -- exactly
+ * what the vendor driver did around cvi_efuse_read_from_shadow(). The
+ * write/program path of the vendor driver is intentionally dropped: burning
+ * fuses is irreversible and nothing here needs it.
+ */
+
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/nvmem-provider.h>
+#include <linux/platform_device.h>
+
+/* Shadow (auto-loaded) mirror of the fuse array, relative to the reg base. */
+#define CV1800_EFUSE_SHADOW_OFFSET	0x100
+#define CV1800_EFUSE_SHADOW_SIZE	0x100
+
+struct cv1800_efuse {
+	void __iomem		*base;
+	struct clk_bulk_data	*clks;
+	int			num_clks;
+};
+
+static int cv1800_efuse_reg_read(void *priv, unsigned int offset,
+				 void *val, size_t bytes)
+{
+	struct cv1800_efuse *efuse = priv;
+	u32 *buf = val;
+	int ret;
+
+	/*
+	 * nvmem enforces our word_size/stride (4), so offset and bytes are
+	 * always multiples of 4 and stay within CV1800_EFUSE_SHADOW_SIZE.
+	 */
+	ret = clk_bulk_prepare_enable(efuse->num_clks, efuse->clks);
+	if (ret)
+		return ret;
+
+	while (bytes >= sizeof(u32)) {
+		*buf++ = readl_relaxed(efuse->base +
+				       CV1800_EFUSE_SHADOW_OFFSET + offset);
+		offset += sizeof(u32);
+		bytes -= sizeof(u32);
+	}
+
+	clk_bulk_disable_unprepare(efuse->num_clks, efuse->clks);
+
+	return 0;
+}
+
+static int cv1800_efuse_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct cv1800_efuse *efuse;
+	struct nvmem_device *nvmem;
+	struct nvmem_config config = {
+		.name			= "cv1800-efuse",
+		.owner			= THIS_MODULE,
+		.type			= NVMEM_TYPE_OTP,
+		.read_only		= true,
+		.word_size		= 4,
+		.stride			= 4,
+		.size			= CV1800_EFUSE_SHADOW_SIZE,
+		.reg_read		= cv1800_efuse_reg_read,
+		.add_legacy_fixed_of_cells = true,
+	};
+
+	efuse = devm_kzalloc(dev, sizeof(*efuse), GFP_KERNEL);
+	if (!efuse)
+		return -ENOMEM;
+
+	efuse->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(efuse->base))
+		return PTR_ERR(efuse->base);
+
+	efuse->num_clks = devm_clk_bulk_get_all(dev, &efuse->clks);
+	if (efuse->num_clks < 0)
+		return dev_err_probe(dev, efuse->num_clks,
+				     "failed to get eFUSE clocks\n");
+	if (efuse->num_clks == 0)
+		return dev_err_probe(dev, -EINVAL,
+				     "no eFUSE clock specified\n");
+
+	config.dev = dev;
+	config.priv = efuse;
+
+	nvmem = devm_nvmem_register(dev, &config);
+
+	return PTR_ERR_OR_ZERO(nvmem);
+}
+
+static const struct of_device_id cv1800_efuse_of_match[] = {
+	{ .compatible = "sophgo,cv1800b-efuse" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cv1800_efuse_of_match);
+
+static struct platform_driver cv1800_efuse_driver = {
+	.probe = cv1800_efuse_probe,
+	.driver = {
+		.name = "cv1800-efuse",
+		.of_match_table = cv1800_efuse_of_match,
+	},
+};
+module_platform_driver(cv1800_efuse_driver);
+
+MODULE_DESCRIPTION("Sophgo CV1800/SG2002 eFUSE nvmem driver");
+MODULE_LICENSE("GPL");
