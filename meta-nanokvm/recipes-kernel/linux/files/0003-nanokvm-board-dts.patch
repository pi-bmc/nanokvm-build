From: NanoKVM build <nbatkins@gmail.com>
Date: Tue, 8 Jul 2026 00:00:00 +0000
Subject: [PATCH] riscv: dts: sophgo: nanokvm board (usb, i2c1 eeprom, ethernet)

NanoKVM board customisation, applied on top of the upstream USB backport
(0001-apply-dts-usb-dev.patch):

  * USB: the upstream node defaults nano-b to dr_mode = "host", but the
    NanoKVM BMC role needs the gadget stack (HID / mass-storage / ECM /
    UVC to the managed machine), so switch it to "peripheral".

  * I2C1: enable i2c1@4010000 and repurpose two SDIO1 pads as its bus
    (SD1_D3 -> IIC1_SCL, SD1_D0 -> IIC1_SDA, both pad funcsel 2, the
    mainline replacement for the vendor devmem pinmux hack). Add the
    i2c-slave-eeprom child with the I2C_OWN_SLAVE_ADDRESS flag so the
    DesignWare controller probes in slave mode and presents an EEPROM to
    the external host (Raspberry Pi).

    The consumer is the OP-TEE BMC sensor pTA on that host, which pushes
    SoC temperature samples to slave 0x50 at EEPROM offset 0x7800 from
    the secure world. 24c512 is the part to emulate rather than a smaller
    one: it is 64 KiB with 16-bit addressing, and an 8-bit part could not
    address 0x7800 at all.

  * Ethernet: enable gmac0 + the mdio-mux so the SG2002 internal 10/100
    EPHY comes up as eth0.

Not upstream — local to this build.
---
diff --git a/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts b/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts
index b185377..d093ecb 100644
--- a/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts
+++ b/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts
@@ -95,6 +95,82 @@
 };
 
 &usb {
-	dr_mode = "host";
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&pinctrl {
+	i2c1_cfg: i2c1-cfg {
+		i2c1-pins {
+			pinmux = <PINMUX(PIN_SD1_D3, 2)>,
+				 <PINMUX(PIN_SD1_D0, 2)>;
+			bias-pull-up;
+			drive-strength-microamp = <10800>;
+			power-source = <3300>;
+		};
+	};
+
+	uart1_cfg: uart1-cfg {
+		uart1-pins {
+			pinmux = <PINMUX(PIN_JTAG_CPU_TMS, 6)>,
+				 <PINMUX(PIN_JTAG_CPU_TCK, 6)>;
+			bias-pull-up;
+			drive-strength-microamp = <10800>;
+			power-source = <3300>;
+		};
+	};
+
+	gpio0_cfg: gpio0-cfg {
+		gpio0-pins {
+			pinmux = <PINMUX(PIN_EMMC_CMD, 3)>,
+				 <PINMUX(PIN_EMMC_DAT1, 3)>,
+				 <PINMUX(PIN_EMMC_DAT0, 3)>,
+				 <PINMUX(PIN_EMMC_DAT3, 3)>;
+			bias-pull-up;
+			drive-strength-microamp = <10800>;
+			power-source = <3300>;
+		};
+	};
+};
+
+&i2c1 {
+	pinctrl-0 = <&i2c1_cfg>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	eeprom@50 {
+		compatible = "linux,slave-24c512";
+		reg = <0x40000050>;
+	};
+};
+
+&gmac0 {
+	status = "okay";
+};
+
+&uart1 {
+	pinctrl-0 = <&uart1_cfg>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&gpio0 {
+	pinctrl-0 = <&gpio0_cfg>;
+	pinctrl-names = "default";
+};
+
+&porta {
+	gpio-line-names =
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "",
+		"power-button",
+		"power-led",
+		"hdd-led",
+		"",
+		"reset-button";
+};
+
+&mdio {
 	status = "okay";
 };
