#!/bin/sh
# NanoKVM BMC Service
#
# The root is an immutable squashfs with a volatile overlay; the daemon runs
# directly from whichever install is newest and runnable:
#
#   /var/lib/nanokvm/app        current self-update (persistent data partition)
#   /var/lib/nanokvm/app.prev   previous install (rollback after a bad update)
#   /kvmapp                     factory copy baked into the squashfs image
#
# This cascade is what makes self-updates power-cut-safe: the updater installs
# into a fresh app dir with dir-rename swaps (server/service/application), so
# an interrupted update leaves app.prev (or the factory copy) runnable and the
# next start silently falls back. The old copy-to-a-runtime-dir staging is
# gone: nothing ever overwrites a running binary in place any more (updates
# write new files and rename), so ETXTBSY cannot happen and staging would just
# burn a 53 MB SD write per boot.
#
# NB: the upstream packaging/etc/init.d/S95nanokvm drives start-stop-daemon
# with Debian-only options (-O logfile, -d chdir) that BusyBox's
# start-stop-daemon does not implement, so the daemon would silently fail to
# launch on this image. This variant uses only BusyBox-supported options; the
# server reads /etc/kvm and writes its own log, so neither option is needed.

DAEMON="NanoKVM-Server"
APP_BASE="/var/lib/nanokvm"
BUILTIN_DIR="/kvmapp"
# PID file on the /run tmpfs so it is cleared on every boot.
PID_FILE="/run/${DAEMON}.pid"

app_root() {
    for dir in "${APP_BASE}/app" "${APP_BASE}/app.prev" "${BUILTIN_DIR}"; do
        if [ -x "${dir}/server/${DAEMON}" ]; then
            echo "${dir}"
            return 0
        fi
    done
    return 1
}

start() {
    root=$(app_root) || { echo "FAIL (no runnable ${DAEMON})"; return 1; }
    [ "${root}" = "${APP_BASE}/app" ] || echo "note: running from ${root}"
    # -S start, -b background, -m write pidfile with the child PID, -o exit 0
    # if already running, -p pidfile, -x the daemon binary.
    start-stop-daemon -S -b -m -o -p "${PID_FILE}" -x "${root}/server/${DAEMON}" \
        && echo "OK" || echo "FAIL"
}

stop() {
    # Match by pidfile only (no -x): after an update the on-disk binary path
    # can differ from the one the running process was launched from.
    start-stop-daemon -K -o -p "${PID_FILE}"
    ret=$?
    rm -f "${PID_FILE}"
    [ ${ret} -eq 0 ] && echo "OK" || echo "FAIL"
}

status() {
    if start-stop-daemon -K -t -q -p "${PID_FILE}"; then
        echo "NanoKVM is running (PID $(cat "${PID_FILE}" 2>/dev/null))"
    else
        echo "NanoKVM is not running"
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    status)  status ;;
    restart) stop; sleep 1; start ;;
    *)
        echo "Usage: $0 {start|stop|status|restart}"
        exit 1
        ;;
esac
