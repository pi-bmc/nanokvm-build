#!/bin/sh

PIDFILE=/var/run/nanokvm.pid
DAEMON=/usr/bin/nanokvm
DATADIR=/usr/share/nanokvm

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "nanokvm is already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    cd "$DATADIR"
    "$DAEMON" >/var/log/nanokvm.log 2>&1 &
    echo $! > "$PIDFILE"
    echo "Started nanokvm (pid $!)"
}

stop() {
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
        echo "Stopped nanokvm"
    else
        echo "nanokvm is not running"
        return 1
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "nanokvm is running (pid $(cat "$PIDFILE"))"
        else
            echo "nanokvm is not running"
            exit 1
        fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
