#!/bin/sh
# First-boot filesystem setup for NanoKVM BMC
#
# Partition layout on /dev/mmcblk0:
#   p1 — /boot           (vfat, factory image)
#   p2 — / rootfs        (ext4, fixed at 8192 MB)
#   p3 — /data           (exfat, occupies all remaining space)
#                        Created on first boot. Holds firmware images,
#                        ISO media, configs, and persistent BMC state.
#
# This deliberately stays a sysvinit script rather than becoming a udev rule.
# udev runs RUN+= programs synchronously on the event worker and kills them at
# udev_event_timeout; parted + resize2fs + mkfs.exfat on a slow SD card blow
# straight through that and would stall the whole event queue behind them.
# Partitioning is a one-shot provisioning step, not a device-arrival reaction.
#
# The steady-state mounts that used to live here (/boot, configfs, debugfs) are
# now in /etc/fstab, so mountall.sh (rcS S03) does them before udev starts
# (rcS S04). That ordering is what lets the USB-gadget udev rule read
# /boot/usb.* during coldplug — see 60-nanokvm-usbgadget.rules.

case "$1" in
    start)
        printf "Resizing rootfs partition (p2): "
        # Pin p2 to a deterministic 8192 MB so any leftover space at the
        # end of the device is available for the data partition. parted is
        # idempotent — this is a no-op if p2 is already the requested size.
        parted -s /dev/mmcblk0 "resizepart 2 -0" >/dev/null 2>&1
        echo "yes
        8192MB
        " | parted ---pretend-input-tty /dev/mmcblk0 "resizepart 2 8192MB" >/dev/null 2>&1
        (resize2fs /dev/mmcblk0p2 >/dev/null 2>&1) &
        echo "OK"

        # Create p3 on first boot using all remaining space after p2.
        if [ ! -e /dev/mmcblk0p3 ]; then
            printf "Creating data partition (p3): "
            parted -s /dev/mmcblk0 "mkpart primary 8193MB 100%" >/dev/null 2>&1
            # Wait briefly for the kernel to expose the new partition node.
            for _ in 1 2 3 4 5; do
                [ -e /dev/mmcblk0p3 ] && break
                sleep 1
            done
            mkfs.exfat /dev/mmcblk0p3 >/dev/null 2>&1
            echo "OK"
        fi

        # Mount /data and ensure BMC staging directories exist. Not in fstab:
        # p3 does not exist until the block above creates it on first boot.
        if [ -e /dev/mmcblk0p3 ]; then
            printf "Mounting /data: "
            mkdir -p /data
            mount /dev/mmcblk0p3 /data 2>/dev/null
            mkdir -p /data/firmware /data/firmware/files /data/media
            echo "OK"

            # Seed the Raspberry Pi boot image the USB mass-storage gadget
            # serves as lun.0. pibmc-firmware-seed ships it gzip-compressed in
            # the rootfs; decompress once to the path the NanoKVM server
            # presents (config default Firmware.ImagePath). The server only
            # downloads a firmware image when this file is absent, so seeding it
            # makes the Pi boot our locally-built U-Boot with no network fetch.
            # Written to a temp file then renamed so a power cut mid-write never
            # leaves the server (which starts later, at rc5 S95) a short image.
            seed=/usr/share/pibmc/uboot-rpi.img.gz
            target=/data/firmware/uboot-rpi.img
            if [ -s "$seed" ] && [ ! -e "$target" ]; then
                printf "Seeding Pi boot image: "
                if zcat "$seed" > "$target.tmp" 2>/dev/null; then
                    mv -f "$target.tmp" "$target"
                    echo "OK"
                else
                    rm -f "$target.tmp"
                    echo "FAIL"
                fi
            fi
        fi
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
