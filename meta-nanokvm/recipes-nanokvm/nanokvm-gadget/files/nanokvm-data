#!/bin/sh
# One-shot data-partition seeding for the NanoKVM BMC.
#
# The provisioning that used to live here (S01fs: create/format/grow the
# partitions) moved into the initramfs, which owns the disk before the root
# is even mounted. What remains is seeding /var/lib/nanokvm (the persistent
# ext4 data partition, mounted by the initramfs) with content shipped in the
# read-only squashfs image:
#
#   * the Raspberry Pi boot image the USB mass-storage gadget serves as
#     lun.0 -- shipped gzip-compressed in the image, decompressed once to the
#     path the server presents (config default firmware.imagePath). The
#     server only downloads a firmware image when this file is absent, so
#     seeding it makes the Pi boot our locally-built U-Boot with no network
#     fetch.

DATA=/var/lib/nanokvm

case "$1" in
    start)
        seed=/usr/share/rpi/uboot-rpi.img.gz
        target=${DATA}/firmware/uboot-rpi.img
        if [ -s "$seed" ] && [ ! -e "$target" ]; then
            printf "Seeding Pi boot image: "
            mkdir -p "${DATA}/firmware"
            # Temp file + rename so a power cut mid-write never leaves the
            # server (which starts later, at rc5 S95) a short image.
            if zcat "$seed" > "$target.tmp" 2>/dev/null; then
                mv -f "$target.tmp" "$target"
                echo "OK"
            else
                rm -f "$target.tmp"
                echo "FAIL"
            fi
        fi
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
