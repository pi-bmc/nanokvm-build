# Minimal cvitek build config for the sophgo-middleware module build.
# Makefile.param does `include $(BUILD_PATH)/.config`; the middleware only reads
# a handful of CONFIG_* gates from it (most default off). The chip/arch/SDK
# selection and toolchain are passed on the make command line by the recipe.
CONFIG_CHIP_sg2002=y
CONFIG_BOARD_licheervnano_sd=y
CONFIG_ARCH="riscv"
CONFIG_CROSS_COMPILE="riscv64-unknown-linux-musl-"
CONFIG_TOOLCHAIN_MUSL_RISCV64=y
CONFIG_SENSOR_GCORE_GC4653=y
