 		i2c_set_bus_num(bus);
diff --git a/cmd/efidebug.c b/cmd/efidebug.c
index 109496d9e95..cb86b3efa9e 100644
--- a/cmd/efidebug.c
+++ b/cmd/efidebug.c
@@ -8,6 +8,7 @@
 #include <charset.h>
 #include <command.h>
 #include <dm/device.h>
+#include <dm/uclass.h>
 #include <efi_device_path.h>
