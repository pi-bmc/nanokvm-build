/*
 * UEFI variable store EEPROM on RP1 I2C1 (Raspberry Pi 5 / BCM2712).
 *
 * U-Boot persists its non-volatile UEFI variables (BootOrder, Boot####,
 * BootNext, ...) as a single serialized blob (ubootefi.var format:
 * magic/length/CRC32) at offset 0 of a 24c256 EEPROM on the 40-pin header
 * i2c bus (CONFIG_EFI_VARIABLE_I2C_STORE). The "EEPROM" may be a real part
 * or an I2C slave emulated by the BMC, which can then read and rewrite the
 * boot options out-of-band.
 *
 * The bcm2712 device tree shipped in the Talos kernel OCI image (the base
 * DTB for this project) carries no i2c nodes under the RP1 pci-ep-bus, so
 * this overlay adds the Designware I2C1 controller (RP1 peripheral offset
 * 0x74000) with the EEPROM child. Nodes are added by absolute path because
 * the base DTB has no symbols/labels.
 *
 * The base DTB also has no label for the RP1 clock controller, so the
 * controller references a fixed-clock mirroring clk_sys (200 MHz, pinned by
 * assigned-clock-rates in the mainline rp1-common.dtsi); U-Boot's
 * Designware driver only uses it to derive SCL timings.
 *
 * The i2c1-pins group (GPIO2/3 funcsel a3 = i2c1_sda/i2c1_scl per the RP1
 * datasheet) uses numeric pins/function values parsed by U-Boot's rp1
 * pinctrl driver (drivers/gpio/rp1_gpio.c). Linux ignores this node: the
 * Talos kernel's dw-i2c will not bind without an interrupts property, and
 * the pin group intentionally targets only the U-Boot driver.
 */
/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2712";

	fragment@0 {
		target-path = "/axi/pcie@1000120000/rp1_nexus/pci-ep-bus@1/pinctrl@400d0000";
		__overlay__ {
			rp1_i2c1_pins: i2c1-pins {
				pins = <2 3>;
				function = <3>;
				bias-pull-up;
			};
		};
	};

	fragment@1 {
		target-path = "/axi/pcie@1000120000/rp1_nexus/pci-ep-bus@1";
		__overlay__ {
			clk_rp1_sys_fixed: i2c1-refclk {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <200000000>;
				clock-output-names = "rp1-clk-sys-fixed";
			};

			i2c@40074000 {
				compatible = "snps,designware-i2c";
				reg = <0x00 0x40074000  0x0 0x1000>;
				#address-cells = <1>;
				#size-cells = <0>;
				clocks = <&clk_rp1_sys_fixed>;
				clock-frequency = <100000>;
				pinctrl-names = "default";
				pinctrl-0 = <&rp1_i2c1_pins>;

				eeprom@50 {
					compatible = "atmel,24c256";
					reg = <0x50>;
					pagesize = <64>;
				};
			};
		};
	};
};
