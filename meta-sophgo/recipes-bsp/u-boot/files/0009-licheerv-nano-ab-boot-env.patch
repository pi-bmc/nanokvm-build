From: NanoKVM build <nbatkins@gmail.com>
Subject: [PATCH] licheerv-nano: A/B boot env and FIT staging address

The NanoKVM image boots a single FIT (boot_<slot>.itb: kernel + FDT +
initramfs) selected by an A/B slot variable, instead of extlinux loading
four separate files. Two changes are needed in the board env:

1. kernel_addr_r moves 0x81000000 -> 0x83000000. It is now the *staging*
   address for the whole FIT, and the FIT's kernel sub-image is extracted
   down to its 0x80200000 run address. At 0x81000000 the kernel's run
   region would grow into the staged FIT and bootm would abort with "new
   format image overwritten - must RESET the board to recover" -- the exact
   failure that killed the first FIT attempt, when the kernel was ~28 MiB.
   Staging above the run region removes the coupling: the kernel is bounded
   by fdt_addr_r=0x82000000 (30 MiB) instead of by the staging address, and
   the linux-sophgo bbappend asserts that budget.

2. The A/B variables themselves (NKVM_AB_ENV).

Everything stays below bootm_size=0x9500000, i.e. under the ION carveout at
0x89500000 (see the ramdisk-addr patch).

Upstream-Status: Inappropriate [NanoKVM boot-flow specific]
---
--- a/include/configs/licheerv_nano.h
+++ b/include/configs/licheerv_nano.h
@@ -14,13 +14,40 @@
 
 #define CFG_SYS_SDRAM_BASE         0x80000000
 
+/*
+ * NanoKVM A/B boot.
+ *
+ * bootslot names the active slot ("a"|"b"); it selects both the boot payload
+ * (boot_a.itb / boot_b.itb on the FAT boot partition) and, via the
+ * nanokvm.slot= cmdline the initramfs reads, the rootfs squashfs slot. One
+ * variable, both halves, so they can never disagree.
+ *
+ * nkvm_boot tries the active slot and, if the load or bootm fails, swaps and
+ * tries the other one in the same boot. altbootcmd is what BOOTCOUNT_LIMIT
+ * runs once bootlimit consecutive attempts have failed to reach a healthy
+ * userspace: it swaps first, so a bad update falls back on its own.
+ *
+ * Steady-state boots write NOTHING: bootcount_env only persists the counter
+ * while upgrade_available is set, which userspace does only around an update.
+ */
+#define NKVM_AB_ENV \
+								"bootslot=a\0" \
+								"bootlimit=3\0" \
+								"nkvm_args=console=ttyS0,115200 earlycon=sbi net.ifnames=0 loglevel=0\0" \
+								"nkvm_load=fatload mmc 0:1 ${kernel_addr_r} boot_${bootslot}.itb\0" \
+								"nkvm_try=setenv bootargs ${nkvm_args} nanokvm.slot=${bootslot}; run nkvm_load && bootm ${kernel_addr_r}\0" \
+								"nkvm_swap=if test ${bootslot} = a; then setenv bootslot b; else setenv bootslot a; fi; setenv bootcount 0; saveenv\0" \
+								"nkvm_boot=run nkvm_try; echo NanoKVM: slot ${bootslot} did not boot, switching; run nkvm_swap; run nkvm_try\0" \
+								"altbootcmd=run nkvm_swap; run nkvm_boot\0"
+
 #define CFG_EXTRA_ENV_SETTINGS  "consoledev=ttyS0\0" \
 								"baudrate=115200\0" \
 								"bootm_size=0x9500000\0" \
 								"fdt_addr_r=0x82000000\0" \
-								"kernel_addr_r=0x81000000\0" \
+								"kernel_addr_r=0x83000000\0" \
 								"ramdisk_addr_r=0x84000000\0" \
 								"scriptaddr=0x80c00000\0" \
+								NKVM_AB_ENV \
 								BOOTENV
 
 #endif /* __CONFIG_H */
